{
  "name": "iso-iterate",
  "version": "0.1.4",
  "type": "module",
  "license": "MIT",
  "description": "Iteration — a dev-only internal feedback loop for coding agents. One integration line adds a bottom-right panel where reviewers write notes like chat messages, optionally pinned to a real UI element, into a local gitignored file; a CLI lets the agent read notes and mark them done. Vite plugin, framework-free server handler, or a standalone script for any host.",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    "./react": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./serve": {
      "types": "./dist/serve.d.ts",
      "import": "./dist/serve.js"
    },
    "./vite": {
      "types": "./dist/vite-plugin.d.ts",
      "import": "./dist/vite-plugin.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "files": ["dist"],
  "bin": {
    "iso-iterate": "./dist/cli.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsup",
    "check": "pnpm typecheck && pnpm lint && pnpm build && pnpm test",
    "prepublishOnly": "pnpm check"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "vite": "^5 || ^6 || ^7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19",
    "react-dom": "^19",
    "tsup": "^8",
    "typescript": "^5",
    "vite": "^7",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "feedback",
    "review",
    "dev-tool",
    "vite-plugin",
    "coding-agent",
    "annotations",
    "design-review",
    "claude",
    "iteration"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaroi/iso-iterate.git"
  },
  "homepage": "https://github.com/aaroi/iso-iterate#readme",
  "bugs": "https://github.com/aaroi/iso-iterate/issues"
}
